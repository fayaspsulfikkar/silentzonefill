# ============================================================
# Silent Zone Registration Automation — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# In production, default placeholder credentials will be rejected.
# ============================================================

# --- Environment ---
APP_ENV=production

# --- App Security ---
# Must be at least 16 characters. Generate using: openssl rand -hex 24
APP_SECRET_KEY=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-to-another-long-random-string

# --- Registration Config (personal info — keep private) ---
REG_NAME=
REG_PHONE=
REG_EMAIL=
REG_BATCH=
REG_RULES_AGREEMENT=YES
REG_COORDINATOR=NO

# --- Telegram Notifications (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard Auth ---
# In production, DASHBOARD_PASSWORD must be at least 8 characters (default will be rejected)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# --- Database ---
# SQLite (default). Persistent across restarts in ./data/silentzone.db
DATABASE_URL=sqlite+aiosqlite:///./data/silentzone.db

# --- Playwright ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# --- Allowed Google Forms domains (comma-separated, no spaces) ---
ALLOWED_FORM_DOMAINS=docs.google.com,forms.gle
